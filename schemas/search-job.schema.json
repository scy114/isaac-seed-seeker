{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/isaac-seed-seeker/search-job.schema.json",
  "title": "Isaac Seed Seeker Eden Search Job",
  "type": "object",
  "required": ["schema_version", "id", "profile_id", "candidates", "filter"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "profile_id": { "type": "string", "minLength": 1 },
    "character": { "const": "eden", "default": "eden" },
    "candidates": {
      "oneOf": [
        {
          "type": "object",
          "required": ["values"],
          "additionalProperties": false,
          "properties": {
            "values": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "pattern": "^[ABCDEFGHJKLMNPQRSTWXYZ01234V6789]{4} [ABCDEFGHJKLMNPQRSTWXYZ01234V6789]{4}$" }
            }
          }
        },
        {
          "type": "object",
          "required": ["start", "end"],
          "additionalProperties": false,
          "properties": {
            "start": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
            "end": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
            "step": { "type": "integer", "minimum": 1, "default": 1 },
            "max_candidates": { "type": "integer", "minimum": 1, "maximum": 100000, "default": 1000 }
          }
        }
      ]
    },
    "filter": { "$ref": "#/$defs/edenFilter" },
    "max_results": { "type": "integer", "minimum": 1, "default": 20 }
  },
  "$defs": {
    "numberRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" }
      },
      "minProperties": 1
    },
    "idSetFilter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
        "any": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
        "none": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true }
      }
    },
    "edenFilter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "damage": { "$ref": "#/$defs/numberRange" },
        "tears": { "$ref": "#/$defs/numberRange" },
        "move_speed": { "$ref": "#/$defs/numberRange" },
        "shot_speed": { "$ref": "#/$defs/numberRange" },
        "luck": { "$ref": "#/$defs/numberRange" },
        "red_hearts": { "$ref": "#/$defs/numberRange" },
        "soul_hearts": { "$ref": "#/$defs/numberRange" },
        "coins": { "$ref": "#/$defs/numberRange" },
        "keys": { "$ref": "#/$defs/numberRange" },
        "bombs": { "$ref": "#/$defs/numberRange" },
        "active_items": { "$ref": "#/$defs/idSetFilter" },
        "passive_items": { "$ref": "#/$defs/idSetFilter" },
        "card": { "type": "integer", "minimum": 0 },
        "pill": { "type": "integer", "minimum": 0 },
        "trinket": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
